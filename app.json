{
  "expo": {
    "name": "QRR KOP",
    "slug": "QR-ATT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/qrr-kop-app-icon.png",
    "scheme": "qr-attendance",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.kenshen2b.qratt",
      "icon": "./assets/images/qrr-kop-app-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QRR KOP to use your camera to scan attendance QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba98e07d-99ba-48e3-ab0b-16f73c1dc06f"
      }
    },
    "owner": "kenshen_2b"
  }
}
